#!/usr/bin/env bash
set -euo pipefail
trap 'echo "[💥] abort @ ${BASH_SOURCE[0]}:$LINENO"; exit 1' ERR

SETUP="$HOME/.setup"
BACKUP_DIR="$HOME/.setup_restore_backup_$(date +%Y%m%d_%H%M%S)"
log(){ printf '[%s] %s\n' "$(date '+%F %T')" "$*"; }

log "🔧 restoring…"

# Upfront sudo prompt
if ! sudo -n true 2>/dev/null; then
  log "🔒 sudo password required…"
  sudo -v
fi

# Safe backup helper
safe_backup() {
  local target="$1"
  if [[ -e "$target" ]]; then
    mkdir -p "$BACKUP_DIR"
    cp -rf "$target" "$BACKUP_DIR/"
  fi
}

# Wallpapers
for ext in jpg png; do
  src="$SETUP/wallpapers/wallpaper.$ext"
  if [[ -f "$src" ]]; then
    mkdir -p "$HOME/Pictures"
    safe_backup "$HOME/Pictures/wallpaper.$ext"
    cp "$src" "$HOME/Pictures/"
    break
  fi
done

# Fonts
if [[ -d "$SETUP/fonts" ]]; then
  mkdir -p "$HOME/.local/share/fonts"
  rsync -aHAXx --chmod=u+rwX "$SETUP/fonts/" "$HOME/.local/share/fonts/"
  fc-cache -fv
fi

# Zen Browser desktop + user.js
if [[ -f "$SETUP/zen/zen.desktop" ]]; then
  mkdir -p "$HOME/.local/share/applications"
  cp "$SETUP/zen/zen.desktop" "$HOME/.local/share/applications/"
fi

shopt -s nullglob
profile_dirs=("$HOME/.mozilla/firefox"/*.zen* "$HOME/.zen"/*.default*)
shopt -u nullglob
if [[ ${#profile_dirs[@]} -gt 0 && -f "$SETUP/zen/user.js" ]]; then
  for p in "${profile_dirs[@]}"; do
    safe_backup "$p/user.js"
    cp "$SETUP/zen/user.js" "$p/user.js"
  done
fi

# User icon
if [[ -f "$SETUP/user-icon" ]]; then
  sudo install -D "$SETUP/user-icon" "/var/lib/AccountsService/icons/$USER"
  printf '[User]\nIcon=/var/lib/AccountsService/icons/%s\n' "$USER" | \
    sudo tee "/var/lib/AccountsService/users/$USER" >/dev/null
  sudo systemctl restart accounts-daemon || true
fi

# Package install
install_packages() {
  local file="$1"
  local pkg_manager="$2"
  if [[ -f "$file" ]]; then
    read -rp "Install packages from $file with $pkg_manager? [y/N] " ans
    if [[ $ans =~ ^[Yy]$ ]]; then
      if command -v "$pkg_manager" &>/dev/null; then
        xargs -a "$file" sudo "$pkg_manager" -S --needed --noconfirm
      else
        log "⚠️  $pkg_manager missing → skip packages"
      fi
    fi
  fi
}

install_packages "$SETUP/pkglist-repo.txt" "pacman"
install_packages "$SETUP/pkglist-aur.txt" "yay"

# Realtime audio limits
if ! getent group realtime >/dev/null; then
  sudo groupadd realtime
fi
sudo usermod -aG realtime "$USER"
sudo install -Dm644 <(printf '@realtime - rtprio 95\n@realtime - memlock unlimited\n') \
  /etc/security/limits.d/99-realtime.conf

# Secrets Decryption via age
if [[ -f "$SETUP/secrets.tar.age" ]]; then
  if command -v age &>/dev/null; then
    read -rp "Found encrypted secrets. Decrypt now? [y/N] " ans
    if [[ $ans =~ ^[Yy]$ ]]; then
      echo "Paste your AGE private key (or path to key file):"
      read -rsp "Key / File: " AGE_KEY
      echo
      if [[ -f "$AGE_KEY" ]]; then
        age -d -i "$AGE_KEY" "$SETUP/secrets.tar.age" | tar -xz -C "$HOME"
      else
        echo "$AGE_KEY" | age -d -i - "$SETUP/secrets.tar.age" | tar -xz -C "$HOME"
      fi
      log "🔑 Secrets restored successfully."
    fi
  else
    log "⚠️  'age' not installed. Skipping secrets decryption."
  fi
fi

# System files
if [[ -d "$SETUP/etc/greetd/" ]]; then
  sudo rsync -aHAXx "$SETUP/etc/greetd/" /etc/greetd/
fi

if [ -d "$SETUP/pacman-hooks" ]; then
  sudo rsync -aHAXx "$SETUP/pacman-hooks/" /etc/pacman.d/hooks/
fi

if [[ -d "$SETUP/desktops" ]]; then
  mkdir -p "$HOME/.local/share/applications"
  shopt -s nullglob; cp "$SETUP/desktops"/*.desktop "$HOME/.local/share/applications/"; shopt -u nullglob
fi

# GTK Theme sync
GTK3_CONF="$HOME/.config/gtk-3.0/settings.ini"
if command -v gsettings &>/dev/null && [[ -f "$GTK3_CONF" ]]; then
  GTK_THEME=$(grep -E '^gtk-theme-name' "$GTK3_CONF" | cut -d'=' -f2 | xargs || true)
  ICON_THEME=$(grep -E '^gtk-icon-theme-name' "$GTK3_CONF" | cut -d'=' -f2 | xargs || true)
  FONT_NAME=$(grep -E '^gtk-font-name' "$GTK3_CONF" | cut -d'=' -f2 | xargs || true)
  CURSOR_THEME=$(grep -E '^gtk-cursor-theme-name' "$GTK3_CONF" | cut -d'=' -f2 | xargs || true)
  CURSOR_SIZE=$(grep -E '^gtk-cursor-theme-size' "$GTK3_CONF" | cut -d'=' -f2 | xargs || true)

  [[ -n "$GTK_THEME" ]] && gsettings set org.gnome.desktop.interface gtk-theme "$GTK_THEME" || true
  [[ -n "$ICON_THEME" ]] && gsettings set org.gnome.desktop.interface icon-theme "$ICON_THEME" || true
  [[ -n "$FONT_NAME" ]] && gsettings set org.gnome.desktop.interface font-name "$FONT_NAME" || true
  [[ -n "$CURSOR_THEME" ]] && gsettings set org.gnome.desktop.interface cursor-theme "$CURSOR_THEME" || true
  [[ -n "$CURSOR_SIZE" ]] && gsettings set org.gnome.desktop.interface cursor-size "$CURSOR_SIZE" || true
fi

# Enable services
log "⚙️  enabling systemd user services…"
systemctl --user daemon-reload
systemctl --user enable \
  openrgb-server.service \
  openrgb-apply.service \
  ydotoold.service || true

log "✅ restore done — reboot recommended."
