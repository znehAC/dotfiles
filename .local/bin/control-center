#!/usr/bin/env python3
"""Bar-side Control Center button.

SwayNC's config is static, so the network/Bluetooth menus must be regenerated
from live state before the panel opens. This refreshes them, then toggles the
panel -- doing it here rather than in SwayNC's `update-command` avoids
reloading the config while the panel is mid-open.

  control-center          refresh menus, then toggle the panel (on_click)
  control-center label    print the button label: cog + unread count
"""

import os
import subprocess
import sys

COG = "\U000f0493"                      # nf-md-cog
HELPER = os.path.join(os.path.dirname(os.path.realpath(__file__)), "swaync-net")


def notification_count():
    try:
        out = subprocess.run(["swaync-client", "-c"], capture_output=True,
                             text=True, timeout=5).stdout.strip()
        return int(out)
    except Exception:
        return 0


def main():
    if len(sys.argv) > 1 and sys.argv[1] == "label":
        n = notification_count()
        print(f"{COG} {n}" if n > 0 else COG)
        return 0

    # Open the panel FIRST. Blocking on the menu refresh made the click feel
    # sluggish (~200ms before anything appeared). The refresh only rewrites
    # SwayNC's config when the network state actually changed — measured at 0
    # rewrites across 6 consecutive runs in steady state — so running it just
    # behind the panel is normally a no-op and never causes a visible rebuild.
    subprocess.Popen(["swaync-client", "-t"])
    subprocess.Popen([HELPER], start_new_session=True,
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    return 0


if __name__ == "__main__":
    sys.exit(main())
