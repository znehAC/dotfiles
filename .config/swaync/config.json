{
  "$schema": "/etc/xdg/swaync/configSchema.json",
  "ignore-gtk-theme": true,
  "positionX": "right",
  "positionY": "top",
  "control-center-margin-top": 10,
  "control-center-margin-bottom": 30,
  "control-center-margin-right": 10,
  "control-center-width": 420,
  "control-center-height": -1,
  "fit-to-screen": false,
  "notification-window-width": 420,
  "notification-body-image-height": 100,
  "notification-body-image-width": 200,
  "timeout": 5,
  "timeout-low": 3,
  "timeout-critical": 0,
  "keyboard-shortcuts": true,
  "image-visibility": "when-available",
  "transition-time": 120,
  "hide-on-clear": false,
  "hide-on-action": true,
  "script-fail-notify": true,
  "relative-timestamps": true,
  "text-empty": "No notifications",
  "widgets": [
    "menubar",
    "buttons-grid",
    "volume",
    "mpris",
    "calendar",
    "title",
    "notifications"
  ],
  "widget-config": {
    "buttons-grid": {
      "buttons-per-row": 5,
      "actions": [
        {
          "label": "󰂛",
          "type": "toggle",
          "active": false,
          "command": "swaync-client -d >/dev/null",
          "update-command": "swaync-client -D"
        },
        {
          "label": "󰺢",
          "type": "toggle",
          "active": false,
          "command": "sh -c '$HOME/.local/bin/toggle-filter'",
          "update-command": "sh -c 'pgrep -x easyeffects >/dev/null && echo true || echo false'"
        },
        {
          "label": "󰘮",
          "command": "pavucontrol"
        },
        {
          "label": "󰄀",
          "command": "sh -c 'mkdir -p \"$HOME/Pictures/Screenshots\" && grim -g \"$(slurp)\" - | tee \"$HOME/Pictures/Screenshots/$(date +%Y%m%d-%H%M%S).png\" | wl-copy'"
        },
        {
          "label": "󰚰",
          "command": "ghostty -e yay -Syu"
        }
      ]
    },
    "volume": {
      "label": "󰕾",
      "show-per-app": true,
      "show-per-app-icon": true,
      "show-per-app-label": true,
      "expand-per-app": false,
      "empty-list-label": "No active streams",
      "expand-button-label": "󰅀",
      "collapse-button-label": "󰅃"
    },
    "mpris": {
      "show-album-art": "always",
      "autohide": false,
      "loop-carousel": false,
      "blacklist": []
    },
    "calendar": {
      "show-day-label": true,
      "show-date-label": true,
      "show-heading": true,
      "show-day-names": true,
      "show-week-numbers": false,
      "day-format": "%A",
      "date-format": "%B %-d, %Y"
    },
    "title": {
      "text": "Notifications",
      "clear-all-button": true,
      "button-text": "󰆴 Clear"
    },
    "menubar": {
      "menu#net": {
        "label": "󰖩  Adriano e Ana",
        "position": "left",
        "actions": [
          {
            "label": "󰨚  Wi-Fi: On",
            "type": "toggle",
            "active": true,
            "command": "/home/cesar/.local/bin/swaync-net toggle-wifi",
            "update-command": "sh -c '[[ $(nmcli radio wifi) == enabled ]] && echo true || echo false'"
          },
          {
            "label": "󱚽  Adriano e Ana   · connected",
            "command": "/home/cesar/.local/bin/swaync-net con-down 5343dda5-45ad-4ba6-8a5f-ecb540371388"
          },
          {
            "label": "󰅂  Saved · 8",
            "command": "/home/cesar/.local/bin/swaync-net toggle-saved"
          },
          {
            "label": "󰖩  explorernet-Melo 2G",
            "command": "/home/cesar/.local/bin/swaync-net con-up c03eb62a-57e0-4ef1-af5c-6b4d40649138"
          },
          {
            "label": "󰖩  explorernet-Melo 5G",
            "command": "/home/cesar/.local/bin/swaync-net con-up 37d5f5cf-55a6-4825-9009-3a1ed0d3cf0e"
          },
          {
            "label": "󰖩  explorernet-Melo 5G 1",
            "command": "/home/cesar/.local/bin/swaync-net con-up 697c7680-a3db-4fb9-9db5-2e6e3df51c10"
          },
          {
            "label": "󰖩  Home Sweet Home",
            "command": "/home/cesar/.local/bin/swaync-net con-up 4e01108f-f7be-4b12-a1d0-39aef3e41b29"
          },
          {
            "label": "󰖩  Melo5G",
            "command": "/home/cesar/.local/bin/swaync-net con-up d240d8e9-db8d-4ef3-91e5-f203fcc91ba4"
          },
          {
            "label": "󰖩  PICO4_5G",
            "command": "/home/cesar/.local/bin/swaync-net con-up 641b5ae7-025e-4cc7-86ac-ea41e31d0e6f"
          },
          {
            "label": "󰖩  pipip",
            "command": "/home/cesar/.local/bin/swaync-net con-up 03e009ed-c4df-4178-82b4-baa86b8ca849"
          },
          {
            "label": "󰖩  TP-Link_91F6",
            "command": "/home/cesar/.local/bin/swaync-net con-up ef3296eb-ed9b-48f5-acff-5ea91783fe70"
          },
          {
            "label": "󰅀  Show all networks",
            "command": "/home/cesar/.local/bin/swaync-net wifi-more"
          },
          {
            "label": "󰅃  Show fewer networks",
            "command": "/home/cesar/.local/bin/swaync-net wifi-more"
          },
          {
            "label": "󰒓  Network settings",
            "command": "nm-connection-editor"
          }
        ]
      },
      "menu#bt": {
        "label": "󰂯  Bluetooth",
        "position": "left",
        "actions": [
          {
            "label": "󰨚  Bluetooth: On",
            "type": "toggle",
            "active": true,
            "command": "/home/cesar/.local/bin/swaync-net toggle-bt",
            "update-command": "sh -c 'bluetoothctl show 2>/dev/null | grep -q Powered && echo true || echo false'"
          },
          {
            "label": "󰅂  Devices"
          },
          {
            "label": "   [LG] webOS TV UN7310PSC",
            "command": "/home/cesar/.local/bin/swaync-net bt-connect F0:86:20:E3:2F:ED"
          },
          {
            "label": "   Galaxy S25+",
            "command": "/home/cesar/.local/bin/swaync-net bt-connect 98:D7:42:D0:61:1F"
          },
          {
            "label": "󰒓  Bluetooth settings",
            "command": "ghostty -e bluetoothctl"
          }
        ]
      }
    }
  }
}
