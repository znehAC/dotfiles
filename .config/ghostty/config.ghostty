# Ghostty reads ~/.config/ghostty/config; this machine's is config.ghostty.

font-family = GeistMono Nerd Font Mono
font-family = FiraMono Nerd Font Mono
font-family = JetBrainsMono Nerd Font Mono
font-size = 12
font-variation = wght=600

background-opacity = 0.95
window-padding-x = 8
window-padding-y = 6

foreground = #332c2c
background = #fff0f5
cursor-color = #ffb6b9
