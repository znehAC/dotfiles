cursor-style = block
cursor-style-blink = false
shell-integration-features = no-cursor,no-sudo,title,no-ssh-env,no-ssh-terminfo,path
selection-foreground = #332c2c
selection-background = #ffc7d6

palette = 0=#645357
palette = 1=#8b4053
